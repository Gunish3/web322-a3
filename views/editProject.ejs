<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Edit Project</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="/css/main.css" rel="stylesheet" />
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="py-10 px-6 bg-gradient-to-b from-blue-100 to-white">
    <div class="max-w-3xl mx-auto space-y-6">

      <!-- Header -->
      <section class="card bg-white shadow-xl p-6">
        <h1 class="text-3xl font-bold mb-2">
          Edit Project – <%= project.title %>
        </h1>
        <p class="text-sm opacity-70">
          Update the details below and click <strong>“Update Project”</strong>.
        </p>
      </section>

      <!-- Edit form -->
      <section class="card bg-white shadow-xl p-6">
        <form action="/solutions/editProject" method="POST" class="space-y-4">

          <!-- hidden id -->
          <input type="hidden" name="id" value="<%= project.id %>" />

          <div class="form-control">
            <label class="label font-semibold">Title</label>
            <input
              type="text"
              name="title"
              class="input input-bordered w-full"
              required
              value="<%= project.title %>"
            />
          </div>

          <div class="form-control">
            <label class="label font-semibold">Feature Image URL</label>
            <input
              type="url"
              name="feature_img_url"
              class="input input-bordered w-full"
              required
              value="<%= project.feature_img_url %>"
            />
          </div>

          <div class="form-control">
            <label class="label font-semibold">Sector</label>
            <select name="sector_id" class="select select-bordered w-full" required>
              <option disabled>Select a sector</option>

              <% [
                { id: 1, name: "Land Sinks" },
                { id: 2, name: "Industry" },
                { id: 3, name: "Transportation" },
                { id: 4, name: "Electricity" },
                { id: 5, name: "Food, Agriculture, and Land Use" }
              ].forEach(s => { %>

                <option value="<%= s.id %>" <%= (project.sector_id == s.id) ? "selected" : "" %>>
                  <%= s.name %>
                </option>

              <% }) %>
            </select>
          </div>

          <div class="form-control">
            <label class="label font-semibold">Intro</label>
            <textarea
              name="intro_short"
              rows="3"
              class="textarea textarea-bordered w-full"
              required
            ><%= project.intro_short %></textarea>
          </div>

          <div class="form-control">
            <label class="label font-semibold">Summary</label>
            <textarea
              name="summary_short"
              rows="3"
              class="textarea textarea-bordered w-full"
              required
            ><%= project.summary_short %></textarea>
          </div>

          <div class="form-control">
            <label class="label font-semibold">Impact</label>
            <textarea
              name="impact"
              rows="3"
              class="textarea textarea-bordered w-full"
              required
            ><%= project.impact %></textarea>
          </div>

          <div class="form-control">
            <label class="label font-semibold">Original Source URL</label>
            <input
              type="url"
              name="original_source_url"
              class="input input-bordered w-full"
              required
              value="<%= project.original_source_url %>"
            />
          </div>

          <!-- UPDATE & CANCEL BUTTONS -->
          <div class="mt-4 flex gap-3">
            <button type="submit" class="btn btn-primary">
              Update Project
            </button>
            <a href="/solutions/projects/<%= project.id %>" class="btn btn-outline">
              Cancel
            </a>
          </div>
        </form>

        <!-- DELETE BUTTON -->
        <div class="mt-6">
          <a
            href="/solutions/deleteProject/<%= project.id %>"
            class="btn btn-error"
            onclick="return confirm('Are you sure you want to delete this project?');"
          >
            Delete Project
          </a>
        </div>

      </section>
    </div>
  </main>
</body>
</html>
