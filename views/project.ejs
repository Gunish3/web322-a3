<!DOCTYPE html>
<html lang="en" data-theme="dim">
<head>
  <meta charset="UTF-8" />
  <title><%= project.title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="/css/main.css" rel="stylesheet" />
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container mx-auto p-4 prose">
    <h1><%= project.title %></h1>
    <p><strong>Sector:</strong> <%= project.Sector.sector_name %>
</p>
    <img class="rounded-xl" src="<%= project.feature_img_url %>" alt="<%= project.title %>">
    <h2>Intro</h2>
    <p><%= project.intro_short %></p>
    <h2>Impact</h2>
    <p><%= project.impact %></p>
    <p>
      <a class="btn btn-primary" href="<%= project.original_source_url %>" target="_blank" rel="noopener">Learn more</a>
      <a class="btn" href="#" onclick="history.back();return false;">Go Back</a>
      <a href="/solutions/editProject/<%= project.id %>" class="btn btn-success">
  Edit Project
</a>

    </p>
  </div>
</body>
</html>
